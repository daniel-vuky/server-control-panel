# Development toolchain image (ADR 0009). Everything the project needs runs in here.
FROM node:22-bookworm

COPY --from=golang:1.27.3-bookworm /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:/go/bin:$PATH \
    GOPATH=/go \
    GOCACHE=/root/.cache/go-build \
    GOFLAGS=-buildvcs=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends shellcheck \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@12.16.1 --activate \
    && pnpm -v \
    && curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/v2.15.0/install.sh \
        | sh -s -- -b /usr/local/bin v2.15.0 \
    && go install github.com/air-verse/air@v1.67.4 \
    && git config --system --add safe.directory '*'

# The panel scans real compose projects in dev, so api needs the same CLI as production (docker:29-cli).
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

WORKDIR /src
